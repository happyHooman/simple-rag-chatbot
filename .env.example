# API Configuration
API_TITLE=FAQ Chatbot
API_VERSION=1.0.0
API_DESCRIPTION="Alexandru Tornea's assignment for RebelDot"

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
POSTGRES_DB=faq_embeddings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/faq_embeddings

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Q&A Service Settings
SIMILARITY_THRESHOLD=0.4
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TEMPERATURE=0.3

# JWT Authentication Settings
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# Flower Configuration (optional - for dev profile)
FLOWER_PORT=5555

# App Port (for Docker)
APP_PORT=8000

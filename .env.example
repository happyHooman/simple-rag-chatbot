# API Configuration
API_TITLE=RebelDot Chatbot
API_VERSION=1.0.0
API_DESCRIPTION="Alexandru Tornea's assignment for RebelDot"

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/faq_embeddings
POSTGRES_DB=faq_embeddings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Q&A Service Settings
SIMILARITY_THRESHOLD=0.5
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TEMPERATURE=0.3

# Authentication Settings
VALID_TOKENS=your_token_list

# Docker Ports (optional overrides)
APP_PORT=8000
FLOWER_PORT=5555
